PORT=4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=iqbal_movers
DB_PORT=3306

# Set a one-time initial admin password before running npm run seed:admin.
INITIAL_ADMIN_PASSWORD=

# Generate a real random string for this, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h
